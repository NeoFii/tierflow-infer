# =============================================================================
# Inference Service — Local Development
# =============================================================================

DEBUG=true
ENV=development
TIMEZONE=Asia/Shanghai

INFERENCE_HOST=0.0.0.0
ALLOWED_HOSTS=*

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
INTERNAL_SECRET=HViOdKUgjeQjWuXzn5ncecMVs6nO1hOhFTyS1i8s4dI
INTERNAL_REQUEST_TTL_SECONDS=30

INFERENCE_SERVICE_SECRET=udFz63AagrvNCCv3m3fNPZUkP6Xu-e_C4V8m3FDoHOE
INFERENCE_ALLOW_INSECURE_DEV=false

INTERNAL_HTTP_MAX_RETRIES=1
INTERNAL_HTTP_RETRY_BACKOFF_SECONDS=0.2
INTERNAL_HTTP_CIRCUIT_BREAKER_THRESHOLD=3
INTERNAL_HTTP_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# -----------------------------------------------------------------------------
# Service discovery
# -----------------------------------------------------------------------------
ADMIN_SERVICE_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Runtime config & model paths
# -----------------------------------------------------------------------------
ROUTER_RUNTIME_CONFIG=./config/runtime_config.json
ROUTER_MODEL_PATHS=./config/model_paths.json

CONFIG_REFRESH_INTERVAL_SECONDS=60
CONFIG_FETCH_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# GPU
# -----------------------------------------------------------------------------
CUDA_VISIBLE_DEVICES=0
GPU_CONCURRENCY_LIMIT=2

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_PREFIX=inference
LOG_TO_FILE=false
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=5
LOG_MAX_DAYS=30
LOG_RING_BUFFER_CAPACITY=2000
